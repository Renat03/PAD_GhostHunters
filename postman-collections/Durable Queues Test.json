{
    "info": {
        "_postman_id": "durable-queue-test-collection",
        "name": "Message Broker - Durable Queue & Dead Letter Tests",
        "description": "Test collection for Grade 6-7-9: Durable Queues, Dead Letter Channel, and Topics endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Setup & Health Checks",
