          "name": "1.3 Sharding Architecture Overview",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Consistent hashing configured correctly', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.sharding.algorithm).to.equal('Consistent Hashing');",
                  "    pm.expect(jsonData.sharding.replicas_per_node).to.equal(150);",
                  "    pm.expect(jsonData.sharding.total_nodes).to.equal(3);",
                  "    pm.expect(jsonData.ring_distribution.total_virtual_nodes).to.equal(450);",
                  "});",
                  "",
                  "console.log('═'.repeat(60));",
                  "console.log('🔧 CONSISTENT HASHING ARCHITECTURE');",
                  "console.log('═'.repeat(60));",
                  "var data = pm.response.json();",
                  "console.log('Algorithm:', data.sharding.algorithm);",
                  "console.log('Virtual Nodes per Physical Node:', data.sharding.replicas_per_node);",
                  "console.log('Total Physical Nodes:', data.sharding.total_nodes);",
