          "name": "1.1 Gateway Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway is healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.ok).to.be.true;",
                  "    pm.expect(jsonData.cache.enabled).to.be.true;",
                  "    pm.expect(jsonData.cache.connected).to.be.true;",
                  "});",
