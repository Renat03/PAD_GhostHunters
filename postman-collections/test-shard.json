        {
          "name": "2.3 Detailed Comparison Explanation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "console.log('═'.repeat(80));",
                  "console.log('📚 UNDERSTANDING THE ALGORITHMS');",
                  "console.log('═'.repeat(80));",
                  "console.log('');",
                  "console.log('MODULO HASHING (Traditional):');",
                  "console.log('  Formula: node = hash(key) % num_nodes');",
                  "console.log('  Problem: When nodes change, EVERYTHING rehashes');",
                  "console.log('  Example: 3 nodes → 4 nodes = hash % 3 → hash % 4');",
                  "console.log('           Result: ~75% of keys change nodes');",
                  "console.log('');",
                  "console.log('CONSISTENT HASHING (Our Implementation):');",
                  "console.log('  1. Create a hash ring (0 to 2³²-1)');",
                  "console.log('  2. Place each node at 150 positions (virtual nodes)');",
                  "console.log('  3. To find node: hash key, walk clockwise to next node');",
                  "console.log('  4. When adding node: only keys between new and next move');",
                  "console.log('           Result: ~25% of keys move (1/n where n = new total)');",
                  "console.log('');",
                  "console.log('VIRTUAL NODES:');",
                  "console.log('  Each physical Redis node gets 150 positions on the ring');",
                  "console.log('  This ensures even distribution even with few nodes');",
                  "console.log('  More virtual nodes = better distribution, more memory');",
                  "console.log('═'.repeat(80));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/cache/compare-algorithms?num_keys=10000",
              "host": ["{{gateway_url}}"],
              "path": ["cache", "compare-algorithms"],
              "query": [
                {
                  "key": "num_keys",
                  "value": "10000"
                }
              ]
            },
            "description": "Same as 2.1 but with detailed explanation in pre-request script"
          }
        }
      ],
      "description": "**CORE REQUIREMENT**: Demonstrates the detailed comparison between Consistent Hashing and Modulo Hashing algorithms"
    },
