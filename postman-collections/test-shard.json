    {
      "name": "2. Algorithm Comparison (KEY TEST)",
      "item": [
        {
          "name": "2.1 Compare Algorithms - 10K Keys",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Consistent hashing is significantly better', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var chPercent = jsonData.consistent_hashing.percent_moved;",
                  "    var modPercent = jsonData.modulo_hashing.percent_moved;",
                  "    ",
                  "    // Consistent hashing should move ~25% of keys",
                  "    pm.expect(chPercent).to.be.below(35);",
                  "    pm.expect(chPercent).to.be.above(15);",
                  "    ",
                  "    // Modulo hashing should move ~75% of keys",
                  "    pm.expect(modPercent).to.be.above(70);",
                  "    ",
                  "    // Improvement should be significant",
                  "    pm.expect(jsonData.comparison.improvement_percent).to.be.above(50);",
                  "});",
                  "",
                  "console.log('═'.repeat(80));",
                  "console.log('⚖️  ALGORITHM COMPARISON: CONSISTENT HASHING vs MODULO HASHING');",
                  "console.log('═'.repeat(80));",
                  "",
                  "var data = pm.response.json();",
                  "",
                  "console.log('\\n📊 TEST PARAMETERS:');",
                  "console.log('  Total Keys Tested:', data.test_parameters.num_keys.toLocaleString());",
                  "console.log('  Initial Nodes:', data.test_parameters.initial_nodes);",
                  "console.log('  Added Node:', data.test_parameters.added_node);",
                  "",
                  "console.log('\\n✅ CONSISTENT HASHING RESULTS:');",
                  "console.log('  Algorithm:', data.consistent_hashing.algorithm);",
                  "console.log('  Keys Moved:', data.consistent_hashing.keys_moved.toLocaleString());",
                  "console.log('  Percent Moved:', data.consistent_hashing.percent_moved + '%');",
                  "console.log('  Expected:', data.consistent_hashing.expected_percent + '%');",
                  "console.log('  Status:', data.consistent_hashing.status);",
                  "",
                  "console.log('\\n❌ MODULO HASHING RESULTS:');",
                  "console.log('  Algorithm:', data.modulo_hashing.algorithm);",
                  "console.log('  Keys Moved:', data.modulo_hashing.keys_moved.toLocaleString());",
                  "console.log('  Percent Moved:', data.modulo_hashing.percent_moved + '%');",
                  "console.log('  Expected:', data.modulo_hashing.expected_percent + '%');",
                  "console.log('  Status:', data.modulo_hashing.status);",
                  "",
                  "console.log('\\n🎯 COMPARISON:');",
                  "console.log('  Keys Saved from Moving:', data.comparison.keys_saved_from_moving.toLocaleString());",
                  "console.log('  Improvement:', data.comparison.improvement_percent + '%');",
                  "console.log('  Cache Hit Rate Preserved:', data.comparison.cache_hit_rate_preserved);",
                  "",
                  "console.log('\\n💡 CONCLUSION:');",
                  "console.log(data.conclusion);",
                  "",
                  "console.log('\\n' + '═'.repeat(80));",
                  "console.log('✅ CONSISTENT HASHING IS ' + data.comparison.improvement_percent + '% BETTER!');",
                  "console.log('═'.repeat(80));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
