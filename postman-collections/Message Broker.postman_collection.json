    {
      "name": "Request Forwarding (Grade 3)",
      "item": [
        {
          "name": "Forward GET Request to Shop",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_name\": \"shop\",\n  \"method\": \"GET\",\n  \"path\": \"/api/shop/items\",\n  \"headers\": {},\n  \"query_params\": {}\n}"
            },
            "url": {
              "raw": "{{broker_url}}/forward",
              "host": ["{{broker_url}}"],
              "path": ["forward"]
            }
          }
        },
        {
          "name": "Forward POST Request (Purchase)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_name\": \"shop\",\n  \"method\": \"POST\",\n  \"path\": \"/api/shop/purchase\",\n  \"headers\": {\n    \"Content-Type\": \"application/json\"\n  },\n  \"body\": {\n    \"userId\": \"user-123\",\n    \"itemId\": 1,\n    \"quantity\": 2\n  }\n}"
            },
            "url": {
              "raw": "{{broker_url}}/forward",
              "host": ["{{broker_url}}"],
              "path": ["forward"]
            }
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
