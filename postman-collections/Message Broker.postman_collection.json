            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"shop.purchase\",\n  \"subscriber_id\": \"inventory-service-1\",\n  \"service_name\": \"inventory\"\n}"
            },
            "url": {
              "raw": "{{broker_url}}/subscribe",
              "host": ["{{broker_url}}"],
              "path": ["subscribe"]
            }
          }
        },
        {
          "name": "Get All Subscribers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/subscribers",
              "host": ["{{broker_url}}"],
              "path": ["subscribers"]
            }
          }
        },
        {
          "name": "Unsubscribe from Topic",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/subscribe/inventory-service-1/shop.purchase",
              "host": ["{{broker_url}}"],
              "path": ["subscribe", "inventory-service-1", "shop.purchase"]
            }
          }
        }
      ]
    },
    {
      "name": "Publishing",
      "item": [
        {
          "name": "Publish to Topic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"shop.purchase\",\n  \"payload\": {\n    \"user_id\": \"user-123\",\n    \"item_id\": \"item-456\",\n    \"quantity\": 2,\n    \"total_cost\": 150\n  },\n  \"sender\": \"shop-service\"\n}"
            },
            "url": {
              "raw": "{{broker_url}}/publish/topic",
              "host": ["{{broker_url}}"],
              "path": ["publish", "topic"]
            }
          }
        },
        {
          "name": "Publish to Subscriber",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"direct.message\",\n  \"payload\": {\n    \"message\": \"Direct message to subscriber\"\n  },\n  \"sender\": \"gateway\"\n}"
            },
            "url": {
              "raw": "{{broker_url}}/publish/subscriber/inventory-service-1",
              "host": ["{{broker_url}}"],
              "path": ["publish", "subscriber", "inventory-service-1"]
            }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Get Messages for Subscriber",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/messages/inventory-service-1?limit=100",
              "host": ["{{broker_url}}"],
              "path": ["messages", "inventory-service-1"],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          }
        },
        {
          "name": "Acknowledge Message",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/acknowledge/inventory-service-1/{{message_id}}",
              "host": ["{{broker_url}}"],
              "path": ["acknowledge", "inventory-service-1", "{{message_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Topics",
      "item": [
        {
          "name": "Get All Topics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/topics",
              "host": ["{{broker_url}}"],
              "path": ["topics"]
            }
          }
        },
        {
          "name": "Get Topic Subscribers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/topics/shop.purchase/subscribers",
              "host": ["{{broker_url}}"],
              "path": ["topics", "shop.purchase", "subscribers"]
            }
          }
