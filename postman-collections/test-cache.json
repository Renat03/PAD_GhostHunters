                        "}"
                    ]}}],
                    "request": {"method": "GET", "url": "{{gateway_url}}/api/inventory"}
                }
            ]
        },
        {
            "name": "6. Cache Invalidation",
            "item": [
                {
                    "name": "Invalidate Shop Cache",
                    "event": [{"listen": "test", "script": {"exec": [
                        "pm.test('Cache invalidated', function() {",
                        "    pm.response.to.have.status(200);",
                        "    console.log('Deleted: ' + pm.response.json().deleted_keys + ' keys');",
                        "});"
                    ]}}],
                    "request": {"method": "DELETE", "url": "{{gateway_url}}/cache/invalidate/shop"}
                },
                {
                    "name": "GET /shop/items (After Invalidation - MISS)",
                    "event": [{"listen": "test", "script": {"exec": [
                        "pm.test('Cache MISS after invalidation', function() {",
                        "    pm.response.to.have.status(200);",
                        "    pm.expect(pm.response.headers.get('X-Cache')).to.equal('MISS');",
                        "    console.log('✅ Cache properly invalidated');",
                        "});"
                    ]}}],
                    "request": {"method": "GET", "url": "{{gateway_url}}/shop/items"}
                }
            ]
        },
        {
            "name": "7. Final Stats",
            "item": [
                {
                    "name": "Get Final Cache Stats",
                    "event": [{"listen": "test", "script": {"exec": [
                        "pm.test('Cache has activity', function() {",
                        "    var json = pm.response.json();",
                        "    pm.expect(json.stats.hits).to.be.above(0);",
                        "    pm.expect(json.stats.misses).to.be.above(0);",
                        "    console.log('📊 Final Stats:');",
                        "    console.log('  Hits: ' + json.stats.hits);",
                        "    console.log('  Misses: ' + json.stats.misses);",
                        "    console.log('  Hit Rate: ' + json.stats.hit_rate_percent + '%');",
                        "});"
                    ]}}],
                    "request": {"method": "GET", "url": "{{gateway_url}}/cache/stats"}
                }
            ]
        }
    ],
    "variable": [
        {"key": "gateway_url", "value": "http://localhost:8081"},
