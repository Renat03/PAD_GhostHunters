{
    "info": {
        "name": "Gateway Cache Tests (Lab 2 Grade 7)",
        "description": "Test Redis caching for commonly accessed GET requests",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Cache Health",
            "item": [
                {
                    "name": "Check Cache Health",
                    "event": [{"listen": "test", "script": {"exec": [
                        "pm.test('Cache is healthy', function() {",
                        "    pm.response.to.have.status(200);",
                        "    var json = pm.response.json();",
                        "    pm.expect(json.status).to.equal('healthy');",
                        "    console.log('✅ Cache latency: ' + json.latency_ms + 'ms');",
                        "});"
                    ]}}],
                    "request": {"method": "GET", "url": "{{gateway_url}}/cache/health"}
                },
                {
                    "name": "Get Cache Stats",
                    "event": [{"listen": "test", "script": {"exec": [
                        "pm.test('Stats available', function() {",
                        "    pm.response.to.have.status(200);",
                        "    var json = pm.response.json();",
                        "    pm.expect(json.enabled).to.be.true;",
                        "    console.log('📊 Hit rate: ' + json.stats.hit_rate_percent + '%');",
                        "});"
                    ]}}],
                    "request": {"method": "GET", "url": "{{gateway_url}}/cache/stats"}
                }
            ]
        },
        {
            "name": "2. Shop Service Caching",
            "item": [
                {
                    "name": "GET /shop/items (1st - MISS)",
                    "event": [{"listen": "test", "script": {"exec": [
                        "pm.test('Cache MISS on first request', function() {",
                        "    pm.response.to.have.status(200);",
                        "    pm.expect(pm.response.headers.get('X-Cache')).to.equal('MISS');",
                        "    console.log('❌ Cache MISS (expected)');",
                        "});"
                    ]}}],
                    "request": {"method": "GET", "url": "{{gateway_url}}/shop/items"}
                },
                {
                    "name": "GET /shop/items (2nd - HIT)",
                    "event": [{"listen": "test", "script": {"exec": [
                        "pm.test('Cache HIT on second request', function() {",
                        "    pm.response.to.have.status(200);",
                        "    pm.expect(pm.response.headers.get('X-Cache')).to.equal('HIT');",
                        "    console.log('🎯 Cache HIT!');",
                        "    console.log('TTL: ' + pm.response.headers.get('X-Cache-TTL') + 's');",
                        "});"
                    ]}}],
                    "request": {"method": "GET", "url": "{{gateway_url}}/shop/items"}
                },
                {
                    "name": "GET /shop/items/{id} (1st - MISS)",
                    "event": [{"listen": "test", "script": {"exec": [
                        "pm.test('Single item - Cache MISS', function() {",
                        "    if (pm.response.code === 200) {",
                        "        pm.expect(pm.response.headers.get('X-Cache')).to.equal('MISS');",
                        "    }",
                        "});"
                    ]}}],
                    "request": {"method": "GET", "url": "{{gateway_url}}/shop/items/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"}
                },
                {
                    "name": "GET /shop/items/{id} (2nd - HIT)",
                    "event": [{"listen": "test", "script": {"exec": [
                        "pm.test('Single item - Cache HIT', function() {",
                        "    if (pm.response.code === 200) {",
                        "        pm.expect(pm.response.headers.get('X-Cache')).to.equal('HIT');",
                        "        console.log('🎯 Single item cache HIT!');",
                        "    }",
                        "});"
                    ]}}],
                    "request": {"method": "GET", "url": "{{gateway_url}}/shop/items/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"}
                }
            ]
        },
