                        "if (pm.response.code === 200) {",
                        "    pm.test('Inventory - Cache HIT', function() {",
                        "        pm.expect(pm.response.headers.get('X-Cache')).to.equal('HIT');",
                        "        console.log('🎯 Inventory cached for 2 min!');",
