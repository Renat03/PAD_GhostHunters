          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/messages/inventory-service-1",
              "host": ["{{broker_url}}"],
              "path": ["messages", "inventory-service-1"]
            }
          },
          "response": []
        }
