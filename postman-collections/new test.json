    {
      "name": "8. End-to-End Integration (Real Workflow)",
      "item": [
        {
          "name": "8.1 Check Shop Services Registered",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/load-balancer/stats",
              "host": ["{{broker_url}}"],
              "path": ["load-balancer", "stats"]
            }
          }
        },
        {
          "name": "8.2 Forward Purchase via Broker (Load Balanced)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_name\": \"shop\",\n  \"method\": \"POST\",\n  \"path\": \"/api/shop/purchase\",\n  \"headers\": {\n    \"Content-Type\": \"application/json\"\n  },\n  \"body\": {\n    \"userId\": \"user-123\",\n    \"itemId\": 1,\n    \"quantity\": 2\n  }\n}"
            },
