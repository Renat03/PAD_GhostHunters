            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"direct.command\",\n  \"payload\": {\n    \"command\": \"check_stock\",\n    \"item_id\": \"item-123\"\n  },\n  \"sender\": \"gateway\"\n}"
