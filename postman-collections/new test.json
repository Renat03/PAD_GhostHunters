          }
        },
        {
          "name": "8.3 Verify Purchase Published to Broker",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/topics",
              "host": ["{{broker_url}}"],
              "path": ["topics"]
            }
          }
        },
        {
          "name": "8.4 Get Shop Items via Broker (Load Balanced)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_name\": \"shop\",\n  \"method\": \"GET\",\n  \"path\": \"/api/shop/items\",\n  \"headers\": {},\n  \"query_params\": {}\n}"
            },
            "url": {
              "raw": "{{broker_url}}/forward",
              "host": ["{{broker_url}}"],
              "path": ["forward"]
            }
          }
        },
        {
          "name": "8.5 Make 5 Purchases - See Load Balancing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Purchase successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "console.log(\"Routed to instance: \" + jsonData.instance_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_name\": \"shop\",\n  \"method\": \"POST\",\n  \"path\": \"/api/shop/purchase\",\n  \"headers\": {\n    \"Content-Type\": \"application/json\"\n  },\n  \"body\": {\n    \"userId\": \"user-123\",\n    \"itemId\": 1,\n    \"quantity\": 1\n  }\n}"
            },
            "url": {
              "raw": "{{broker_url}}/forward",
              "host": ["{{broker_url}}"],
              "path": ["forward"]
            }
          }
        }
      ],
      "description": "Test real Shop Service integration through Message Broker with load balancing"
    }
  ],
  "variable": [
    {
      "key": "broker_url",
      "value": "http://localhost:8002",
      "type": "string"
    },
    {
      "key": "message_id",
      "value": "msg-placeholder",
      "type": "string",
      "description": "Copy message_id from 4.5 response to use in 4.8"
