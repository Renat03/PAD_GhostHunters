{
  "info": {
    "name": "Ghost AI Service",
    "description": "API collection for testing the Ghost AI Service endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Lobby Management",
      "item": [
        {
          "name": "Create Ghost for Lobby",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lobbyId\": \"lobby-123\",\n  \"ghostType\": \"standard\",\n  \"playerIds\": [\"player-1\", \"player-2\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ghost-ai/lobbies",
              "host": ["{{baseUrl}}"],
              "path": ["ghost-ai", "lobbies"]
            },
            "description": "Creates a new ghost instance for a lobby"
          },
          "response": []
        },
        {
          "name": "Get All Active Lobbies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ghost-ai/lobbies",
              "host": ["{{baseUrl}}"],
              "path": ["ghost-ai", "lobbies"]
            },
            "description": "Retrieves all active lobbies with their ghost states"
          },
          "response": []
        },
        {
          "name": "Delete Lobby (Stop Ghost)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ghost-ai/lobbies/{{lobbyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ghost-ai", "lobbies", "{{lobbyId}}"]
            },
            "description": "Deactivates the ghost for a specific lobby"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Ghost State",
      "item": [
        {
          "name": "Get Ghost State",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ghost-ai/lobbies/{{lobbyId}}/state",
              "host": ["{{baseUrl}}"],
              "path": ["ghost-ai", "lobbies", "{{lobbyId}}", "state"]
            },
            "description": "Gets the current state of the ghost in a specific lobby"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Player Interactions",
      "item": [
        {
          "name": "Update Player Position",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"player-1\",\n  \"x\": 10.5,\n  \"y\": 2.0,\n  \"z\": -5.3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ghost-ai/lobbies/{{lobbyId}}/player-positions",
              "host": ["{{baseUrl}}"],
              "path": ["ghost-ai", "lobbies", "{{lobbyId}}", "player-positions"]
            },
            "description": "Updates a player's position in the lobby, affecting ghost AI behavior"
          },
          "response": []
        }
      ]
    },
    {
